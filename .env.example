# Backend — prefix ASSISTANT_
ASSISTANT_ENVIRONMENT=development
ASSISTANT_DOCS_ENABLED=true
ASSISTANT_AUTH_ENABLED=false
ASSISTANT_JWT_SECRET_KEY=change-me-dev-only
ASSISTANT_JWT_AUDIENCE=
ASSISTANT_JWT_ISSUER=
ASSISTANT_LLM_BACKEND=ollama
ASSISTANT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# ASSISTANT_VLLM_OPENAI_BASE_URL=http://vllm:8000/v1
ASSISTANT_DEFAULT_MODEL=deepseek-coder
ASSISTANT_CORS_ALLOW_ORIGINS=[]
ASSISTANT_MAX_REQUEST_BODY_BYTES=2097152
